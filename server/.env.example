# Copy to .env and fill in. Every setting is explained in server/README.md.

# The public site, ending with /. Sign-in links and the events feed come from here.
SITE_URL=https://dongyi-guo.github.io/hellotas/
# Browsers allowed to call the API: the site's origin (scheme and host only)
ALLOWED_ORIGINS=https://dongyi-guo.github.io
# Who can sign in (comma-separated). Keep it to UTAS unless you have moderators ready for the public.
ALLOWED_EMAIL_DOMAINS=utas.edu.au
# These addresses become admins the first time they sign in
ADMIN_EMAILS=
# A long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database. With docker compose (deploy/), this is set for you.
# Hosted Postgres (Neon, Supabase, Cloud SQL): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./hellotas.db

# Email: console (development: printed to the log), smtp, or resend
EMAIL_BACKEND=console
EMAIL_FROM=Tasmania Welcome <hello@example.org>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Website event suggestions become GitHub issues here (fine-grained token: this repository, Issues read and write)
GITHUB_REPO=dongyi-guo/hellotas
GITHUB_TOKEN=

# The weekly digest workflow sends this (same value as the repository secret COMMUNITY_CRON_SECRET)
CRON_SECRET=

# Behind a proxy (Caddy, Cloud Run, Render, Fly): true, so rate limits see the visitor's address
TRUST_PROXY=true
